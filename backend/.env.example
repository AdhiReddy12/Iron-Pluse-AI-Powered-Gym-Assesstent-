# ==========================================
# MySQL Database (e.g. TiDB Cloud / Local MySQL)
# ==========================================
DB_URL=jdbc:mysql://localhost:3306/iron_pulse?useSSL=true
DB_USERNAME=root
DB_PASSWORD=your_database_password

# ==========================================
# JWT Secret
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# ==========================================
# Cookie Security (false for local HTTP, true for HTTPS production)
# ==========================================
auth.cookie.secure=false
auth.cookie.same-site=Lax

# ==========================================
# Gmail SMTP Configuration (Use Gmail App Password)
# ==========================================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ==========================================
# Frontend & CORS
# ==========================================
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Redis Cache Configuration (Upstash / Local)
# ==========================================
REDIS_URL=redis://localhost:6379
